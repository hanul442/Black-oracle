{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nars-v4-collector",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/10 * * * *"] },
  "queues": {
    "producers": [
      { "binding": "NARS_INGEST_QUEUE", "queue": "nars-v4-ingest" }
    ],
    "consumers": [
      {
        "queue": "nars-v4-ingest",
        "max_batch_size": 20,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "nars-v4-ingest-dlq"
      }
    ]
  }
}
