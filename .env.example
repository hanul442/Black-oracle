# OpenAI server-side AI layer. Never expose a real key in client/Vite variables.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
# Model routing: cheap/high-frequency work, Activity Brief, and Council review.
OPENAI_FAST_MODEL="gpt-5.6-luna"
OPENAI_ACTIVITY_MODEL="gpt-5.6-luna"
OPENAI_MODEL="gpt-5.6-terra"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Trading gateway (Paper only in v0.1.x)
TRADING_PORT="3100"
TRADING_AUTOSAVE_MS="60000"
# Set false if a previously-running Paper loop should NOT resume after process restart.
TRADING_RESUME_LOOP="true"

# Persistence backend: json for local development, supabase for durable remote state.
TRADING_PERSISTENCE_BACKEND="json"
TRADING_STATE_FILE=".data/black-oracle-trading-state.json"
TRADING_RUNTIME_ID="black-oracle-paper"

# Korea Investment & Securities (KIS) domestic-equity MARKET DATA only.
# BLACK ORACLE does not submit brokerage orders through these credentials; KRX execution remains internal Paper execution.
# Keep credentials server-side. Prefer demo while qualifying a new multi-asset runtime.
KIS_ENV="demo"
KIS_APP_KEY="YOUR_KIS_APP_KEY"
KIS_APP_SECRET="YOUR_KIS_APP_SECRET"

# Required only when TRADING_PERSISTENCE_BACKEND=supabase.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# SERVER SECRET. Never expose this value in Vite/client code or commit a real value.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_SIDE_SERVICE_ROLE_KEY"

# Required by scheduled/internal Paper-cycle and Council endpoints.
# Keep it server-side and use a long random value.
CRON_SECRET="YOUR_LONG_RANDOM_CRON_SECRET"
