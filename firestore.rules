rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidDocId(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Black Oracle research workspace is strictly user-scoped.
    // The browser uses Firebase Auth and may access only its own UID subtree.
    match /users/{userId}/{collectionName}/{docId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if isOwner(userId) && isValidDocId(docId);
    }

    // Nested documents, if introduced later, inherit the same ownership boundary.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Legacy top-level collections are intentionally not exposed.
    // Server-side trading state lives in Supabase; research state belongs under /users/{uid}/...
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
