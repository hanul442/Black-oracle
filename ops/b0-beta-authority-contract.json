    "browserRolesHaveUsage": false,
    "writableByServer": true
  },
  "legacyBoundary": {
    "schemas": ["public"],
    "protectedPrefixes": ["black_oracle", "nars_", "research_"],
    "protectedState": [
      "positions",
      "orders",
      "ledger",
      "checkpoints",
      "strategy_identity",
      "qualification_cohort"
