    "forbiddenPrivileges": [
      "INSERT",
      "UPDATE",
      "DELETE",
      "TRUNCATE",
      "REFERENCES",
      "TRIGGER",
      "CREATE",
      "OWNERSHIP",
      "SET_ROLE_TO_OPERATIONAL_IDENTITY"
    ]
  },
  "readModelRules": {
    "explicitAllowlistRequired": true,
    "securityInvokerRequired": true,
    "securityDefinerDefault": "FORBIDDEN",
