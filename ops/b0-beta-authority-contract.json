      "EPHEMERAL_DATABASE_TEST",
      "PROHIBITED_LEGACY_MUTATIONS_DENIED",
      "ALLOWED_READ_MODELS_READABLE",
      "BETA_NAMESPACE_WRITES_SUCCEED",
      "ROLLBACK_TESTED",
      "NO_SECRET_IN_REPOSITORY"
