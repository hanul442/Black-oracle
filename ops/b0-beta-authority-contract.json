      "FIXED_SAFE_SEARCH_PATH",
      "INPUT_VALIDATION",
      "NO_DYNAMIC_SQL",
      "EXPLICIT_EXECUTE_GRANT",
      "NEGATIVE_AUTHORITY_TESTS"
